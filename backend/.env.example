# === DATABASE ===
# SQL Server connection string (REQUIRED in production)
NIHONLET_SQL_CONNECTION=
# MongoDB connection string for logging (optional, defaults to localhost)
NIHONLET_MONGODB_CONNECTION=

# === AUTHENTICATION ===
# JWT Secret key - MUST be at least 32 characters (REQUIRED in production)
NIHONLET_JWT_SECRET=

# Windows
NIHONLET_ADMIN_EMAIL=
NIHONLET_ADMIN_PASSWORD=

# === PAYMENT ===
NIHONLET_PAYOS_CLIENT_ID=
NIHONLET_PAYOS_API_KEY=
NIHONLET_PAYOS_CHECKSUM_KEY=

# === AI CHAT (Future) ===
NIHONLET_OPENAI_API_KEY=
