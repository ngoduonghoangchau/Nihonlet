{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NihonLet",
    "Audience": "NihonLetUsers",
    "ExpiryMinutes": 60
  },
  "MongoDb": {
    "DatabaseName": "nihonlet_logs"
  }
}
