{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NihonLet",
    "Audience": "NihonLetUsers",
    "ExpiryMinutes": 60
  },
  "MongoDb": {
    "DatabaseName": "nihonlet_logs"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=NihonLetDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "PayOS": {
    "UseMock": false,
    "ReturnUrl": "https://yourdomain.com/premium-checkout",
    "CancelUrl": "https://yourdomain.com/pricing"
  }
}
